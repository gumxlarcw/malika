# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.pnp/
.pnp.js
.yarn/cache/
.yarn/install-state.gz

# ─── Build output ────────────────────────────────────────────────────────────
.next/
out/
dist/
build/
.turbo/
.swc/
*.tsbuildinfo

# ─── Environment / secrets ───────────────────────────────────────────────────
# NEVER commit these — credentials live in .env files only
.env
.env.local
.env.development.local
.env.test.local
.env.production
.env.production.local
*.pem
*.key
*-key.json

# Allow example files (no secrets, just placeholders)
!.env.example

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pm2/

# ─── Editor / OS ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# ─── Testing / coverage ──────────────────────────────────────────────────────
coverage/
.nyc_output/
junit.xml

# ─── Caches ──────────────────────────────────────────────────────────────────
.cache/
.eslintcache
.stylelintcache

# ─── Backups (per CLAUDE.md, edits write *.backup files) ─────────────────────
*.backup
*.bak

# ─── Playwright + Claude Code runtime artifacts ──────────────────────────────
frontend/test-results/
frontend/playwright-report/
.claude/scheduled_tasks.lock

# ─── Project-specific ────────────────────────────────────────────────────────
# Local archive tables created during destructive ops
_archive_*/
# Local database dumps
*.sql.gz
*.dump

# ─── Sentry ──────────────────────────────────────────────────────────────────
.sentryclirc

# ─── CLAUDE.md backup convention (added 2026-05-09) ──────────────────────────
# The "always cp before edit" rule from ~/.claude/CLAUDE.md creates these.
# They must NEVER reach git — they are scratch only.
**/*.backup
backups/

# ─── Temporary scratch ───────────────────────────────────────────────────────
tmp/

# ─── Claude Code local-only config (added 2026-05-29) ────────────────────────
# Personal notes; and the local settings file, which can accumulate tokens/paths.
CLAUDE.local.md
.claude/settings.local.json

# Artefak nyasar (tugas 5, tidy-worktrees.sh, 2026-08-22)
*.backup-*
*.bak2
*.xlsx

