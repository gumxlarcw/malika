# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/
.pnp/
.pnp.js
.yarn/cache/
.yarn/install-state.gz

# ─── Build output ────────────────────────────────────────────────────────────
.next/
out/
dist/
build/
.turbo/
.swc/
*.tsbuildinfo

# ─── Environment / secrets ───────────────────────────────────────────────────
# NEVER commit these — credentials live in .env files only
.env
.env.local
.env.development.local
.env.test.local
.env.production
.env.production.local
*.pem
*.key
*-key.json

# Allow example files (no secrets, just placeholders)
!.env.example

# ─── Logs ────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pm2/

# ─── Editor / OS ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
*~

# ─── Testing / coverage ──────────────────────────────────────────────────────
coverage/
.nyc_output/
junit.xml

# ─── Caches ──────────────────────────────────────────────────────────────────
.cache/
.eslintcache
.stylelintcache

# ─── Backups (per CLAUDE.md, edits write *.backup files) ─────────────────────
*.backup
*.bak

