# ─────────────────────────────────────────────────────────────────────────────
# MALIKA Backend — Environment Configuration
#
# Copy this file to `.env` and fill in real values.
# Never commit `.env` (already in .gitignore).
# ─────────────────────────────────────────────────────────────────────────────

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=5000
PIPELINE_VERSION=1.0.0
JWT_SECRET=<random-32+char-string>

# ─── Database ────────────────────────────────────────────────────────────────
# Primary DB: project_data_strategis (registry, metadata)
DB_HOST=127.0.0.1
DB_NAME=project_data_strategis
DB_USER=<db-username>
DB_PASS=<db-password>

# ─── BPS API ─────────────────────────────────────────────────────────────────
BPS_API_KEY=<bps-webapi-key>
DNA_NUCLEUS_API_KEY_BPS=<dna-nucleus-key>

# ─── LLM Proxy (malika-llm-proxy on port 3031) ───────────────────────────────
# Backend chat tool talks to a local proxy that fronts Google Gemini + Anthropic
OPENAI_API_URL=http://127.0.0.1:3031/v1/chat/completions
OPENAI_API_KEY_CHAT=malika-internal-proxy
OPENAI_API_BASE_URL=http://127.0.0.1:3031/v1
OPENAI_API_KEY=malika-internal-proxy

# ─── Google API keys (for Gemini direct + embeddings) ────────────────────────
# GOOGLE_API_KEYS = comma-separated pool for round-robin rate limiting
GOOGLE_API_KEY=<single-google-api-key>
GOOGLE_API_KEYS=<key1>,<key2>,<key3>,<key4>,<key5>

# ─── Anthropic (Claude) ──────────────────────────────────────────────────────
ANTHROPIC_TOKEN=<sk-ant-oat01-...>

# ─── OpenAI keys (only used as fallback) ─────────────────────────────────────
OPENAI_API_KEY_EMBEDDINGS=<openai-embedding-key>
OPENAI_API_KEY_QUERY_BUILDER=<openai-query-builder-key>
OPENAI_API_KEY_INTERPRETATION=<openai-interpretation-key>

# ─── LLM models per agent role ───────────────────────────────────────────────
OPENAI_MODEL_CHAT=claude-sonnet-4-6
OPENAI_MODEL_REASONING=claude-sonnet-4-6
OPENAI_MODEL_NANO=claude-sonnet-4-6
OPENAI_MODEL_KEYWORD_EXTRACTOR=claude-sonnet-4-6
OPENAI_MODEL_SYNONYM=claude-sonnet-4-6
OPENAI_MODEL_RERANKER=claude-sonnet-4-6
OPENAI_MODEL_SUGGESTIONS=claude-sonnet-4-6
OPENAI_MODEL_MEMORY=claude-sonnet-4-6
OPENAI_MODEL_COMPACTION=claude-sonnet-4-6
OPENAI_MODEL_VISION=claude-sonnet-4-6
OPENAI_MODEL_TABLE_UNDERSTANDING=claude-sonnet-4-6
OPENAI_INTERPRETATION_MODEL=claude-sonnet-4-6
OPENAI_INTERPRETATION_MODEL_FALLBACK=claude-sonnet-4-6
OPENAI_QUERY_BUILDER_MODEL=claude-sonnet-4-6
OPENAI_QUERY_BUILDER_MODEL_FALLBACK=claude-sonnet-4-6
OPENAI_CHAT_TIMEOUT_MS=60000

# Specialized model IDs for chat sub-routing
GATE_LLM_MODEL=claude-sonnet-4-6
SUPERVISOR_LLM_MODEL=claude-sonnet-4-6
CHAT_TOOL_USE=true

# ─── Automation cron (BPS data refresh) ──────────────────────────────────────
AUTOMATION_ENABLED=true
AUTOMATION_INTERVAL_MINUTES=60
AUTOMATION_RUN_HOUR=2
AUTOMATION_RUN_MINUTE=0

MERGED_CACHE_NOTIFICATIONS_ENABLED=true
MERGED_CACHE_NOTIFICATIONS_INTERVAL_MINUTES=60
PUBLICATION_NOTIFICATIONS_ENABLED=true
PUBLICATION_INTERVAL_MINUTES=60
PRESSRELEASE_NOTIFICATIONS_ENABLED=true

# ─── Search ──────────────────────────────────────────────────────────────────
USE_ANN_SEARCH=false
WEB_SEARCH_ENABLED=false
WEB_SEARCH_CACHE_TTL_MS=600000
WEB_SEARCH_MAX_RESULTS=5
BRAVE_SEARCH_API_KEY=<brave-search-api-key>

# ─── Web Push (PWA notifications) ────────────────────────────────────────────
VAPID_PUBLIC_KEY=<vapid-public-key>
VAPID_PRIVATE_KEY=<vapid-private-key>
VAPID_SUBJECT=mailto:admin@example.com

# ─── Wajib diisi, jika kosong aplikasi gagal start ───────────────────────────
# Identitas anonim chat bersifat fail-closed: anonIdentity.service melempar
# error saat import bila kosong, sebelum test apa pun sempat berjalan.
# Buat nilai acak untuk instance lokal:  openssl rand -hex 32
MALIKA_ANON_SECRET=
MALIKA_IDENTITY_STRICT=true

# ─── Flag pipeline ───────────────────────────────────────────────────────────
USE_UNIFIED_RETRIEVAL=true
CHAT_PIPELINE_V=2
AUTO_TUNE_MODEL=
